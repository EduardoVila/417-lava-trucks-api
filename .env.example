RACK_ENV=production
APP_ENV=production
PORT=8000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PGSSLMODE=require
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_BYTES
ALLOWED_HOSTS=YOUR-APP.koyeb.app,localhost,127.0.0.1
ALLOWED_ORIGINS=https://YOUR-PROJECT.web.app,https://YOUR-PROJECT.firebaseapp.com
